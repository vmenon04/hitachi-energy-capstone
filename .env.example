AZURE_AI_PROJECT_ENDPOINT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_AI_PROJECT_API_KEY=

# SharePoint / MS Graph
# Work account (client credentials): fill CLIENT_ID, CLIENT_SECRET, TENANT_ID, DRIVE_ID.
# Personal account (token cache): fill CLIENT_ID and DRIVE_ID only;
#   run login_and_store_token.py once to store the cache in Key Vault.
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TENANT_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ID=root
# Name of the source folder to ingest. Files land under {FOLDER_NAME}/ in Blob Storage.
SHAREPOINT_FOLDER_NAME=Project_Data

# Key Vault URI — needed locally for personal-account token cache access
# Find it in the Azure Portal under your Key Vault → Overview → Vault URI
AZURE_KEYVAULT_URI=

ACS_CONNECTION_STRING=
EMAIL_FROM_ADDRESS=
EMAIL_RECIPIENT=hitachiseniordesign@outlook.com